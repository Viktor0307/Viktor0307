using System;
using YahooFinanceApi;
using System.Threading.Tasks;

class Program
{
    static async Task Main(string[] args)
    {
        Console.WriteLine("Enter stock ticker (e.g., AAPL, TSLA, MSFT): ");
        string ticker = Console.ReadLine().ToUpper();

        try
        {
            // Fetch stock data
            var securities = await Yahoo.Symbols(ticker)
                                        .Fields(Field.RegularMarketPrice, Field.RegularMarketChangePercent)
                                        .QueryAsync();

            var stock = securities[ticker];

            double price = stock[Field.RegularMarketPrice];
            double changePercent = stock[Field.RegularMarketChangePercent];

            // Round values to 2 decimal places
            price = Math.Round(price, 2);
            changePercent = Math.Round(changePercent, 2);

            Console.WriteLine($"\nTicker: {ticker}");
            Console.WriteLine($"Current Price: ${price}");
            Console.WriteLine($"Change: {changePercent}%");

            // Advice logic
            if (changePercent <= -5)
            {
                Console.WriteLine("👉 I think you should BUY.");
            }
            else if (changePercent >= 10)
            {
                Console.WriteLine("👉 I think you should WAIT until the price is lower.");
            }
            else
            {
                Console.WriteLine("👉 No strong signal. Keep watching.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching data: {ex.Message}");
        }
    }
}
